// Cloudflare Worker со статикой. Сайт собирается статически (astro build) в dist/client.
// Код Worker — только для /api/* (worker/index.ts); остальные адреса отдаёт сервер статики.
//
// ВЫКЛАДКА: только `npx wrangler deploy --config wrangler.jsonc`.
// Адаптер @astrojs/cloudflare при статической сборке пишет свой конфиг
// (dist/client/wrangler.json, через .wrangler/deploy/config.json) без `main`;
// по нему обычный `npx wrangler deploy` падает с ошибкой run_worker_first.
// Явный --config берёт этот файл целиком: Worker + статика + D1.
//
// Секреты (TURNSTILE_SECRET_KEY, TELEGRAM_BOT_TOKEN, CRM_TOKEN) здесь НЕ лежат:
// в Cloudflare — Worker → Settings → Variables and Secrets; локально — .dev.vars (вне Git).
// Несекретные настройки — в "vars" ниже; пустое значение = не задано.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "forrest-trinity-resort",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-10",
  // Домены. Список — полный набор Custom Domains этого Worker: выкладка приводит панель к нему
  // (домен, добавленный только в панели, будет отвязан). DNS-запись Custom Domain Cloudflare создаёт сам.
  // www → основной домен — правило Redirect Rules зоны в панели (docs/ADMIN.md, «Домен»).
  "routes": [
    { "pattern": "forrestresort.com.ua", "custom_domain": true },
    { "pattern": "www.forrestresort.com.ua", "custom_domain": true }
  ],
  // Технический адрес forrest-trinity-resort.forrestresort-com.workers.dev выключен (2026-11-27): он отдавал ту же
  // сборку, что основной домен, — дубль в поиске после открытия индексации. Превью веток (stage и др.) —
  // адреса версий <версия|ветка>-forrest-trinity-resort.forrestresort-com.workers.dev: preview_urls включены явно.
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist/client",
    // Worker вызывается первым только для API; файлы статики идут мимо него.
    "run_worker_first": ["/api/*"],
    // Ненайденная страница — 404 от сервера статики, без вызова Worker.
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      // Заявки (docs/LEADS.md). Схема создаётся самим Worker при первом обращении (worker/db/schema.ts).
      "binding": "DB",
      "database_name": "forrest-leads",
      // ID базы из панели Cloudflare (D1 → forrest-leads), создана 2026-11-20. Не секрет.
      "database_id": "5fc6aabe-877d-46d4-96ab-ec85062feb40"
    }
  ],
  "ratelimits": [
    {
      // Лимит частоты заявок: 5 за 60 секунд с одного IP (приблизительный, по дата-центру).
      "name": "LEAD_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "vars": {
    // Публичный ключ Turnstile (site key), виджет в панели Cloudflare → Turnstile (2026-11-20).
    // Домены виджета: forrestresort.com.ua и forrest-trinity-resort.forrestresort-com.workers.dev —
    // боевой домен и превью работают на одной настоящей паре; секрет — TURNSTILE_SECRET_KEY в панели.
    // Тестовая пара Cloudflare — только localhost (сборка с TURNSTILE_LOCAL_SITE_KEY, npm run build:test).
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGKQ4629lyc9njjl",
    // Telegram: ID чата для заявок (группа — отрицательное число, супергруппа — начинается с -100).
    // Токен бота — секрет TELEGRAM_BOT_TOKEN (панель). Инструкция — docs/ADMIN.md.
    "TELEGRAM_CHAT_ID": "-1003990676609",
    // G-PLUS CRM (значения — из npm run crm:explore, 2026-11-20):
    // источник «Сайт» (/api/v1/lead_sources); этап (/api/v1/pipelines) — пусто: этапа для новых заявок
    // в воронке нет, CRM ставит свой первый; здание FORREST TRINITY RESORT (/api/v1/buildings).
    "CRM_SOURCE": "developer-site",
    "CRM_STAGE_ID": "",
    "CRM_BUILDING_ID": "26458",
    // UTM идут в data.utm: кастомных полей под UTM в CRM нет. Запасной вариант, если data.utm
    // не сохраняется (проверка — npm run crm:check): JSON строкой { "utm_source": "<ID поля>", … }.
    "CRM_UTM_FIELDS": "",
    // Кастомные поля лида (ID — из npm run crm:explore). Пусто — поле не передаётся.
    // «Вибір зручного способу зв'язку» (multiselect): Telegram | WhatsApp | Viber | Мобільний.
    "CRM_FIELD_CONTACT_METHOD": "2d8f405b-9e7e-42e6-94a8-31c17164a344",
    // «Тип планування» (multiselect): формат апартамента (соответствие — worker/channels/crm.ts).
    "CRM_FIELD_LAYOUT": "9666be69-1ca4-4c4f-8f5e-167034382b85",
    // «Google Click ID» и «Fbclid» (строки).
    "CRM_FIELD_GCLID": "gclid",
    "CRM_FIELD_FBCLID": "fbclid"
  },
  // Раз в 10 минут: повторы доставки (через 10 минут и через час) и удаление заявок старше 90 дней.
  // Нет заявок к повтору — только чтение базы, внешних запросов нет (worker/scheduled.ts).
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true }
}
