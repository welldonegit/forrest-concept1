# Локальные настройки Worker (wrangler dev). Скопировать в .dev.vars — он вне Git.
# Тестовый секрет Turnstile от Cloudflare: всегда успех. Worker принимает его только на localhost
# (превью и боевой домен — настоящая пара). Сайт для него собирать с тестовым ключом: npm run build:test.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Каналы — пусто = «не настроен». Настоящие токены сюда не коммитить.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# CRM_TOKEN=
# Только для тестов (подменяют адреса API на поддельные серверы); в бою не задаются:
# TELEGRAM_API_BASE=
# CRM_API_BASE=
