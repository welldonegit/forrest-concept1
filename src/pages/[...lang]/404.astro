---
/**
 * Страница 404: адрес, которого нет на сайте. Сборка кладёт её в /404.html (основной язык)
 * и /en/404.html (integrations/not-found.ts): сервер статики
 * Cloudflare отдаёт ближайший 404.html (wrangler.jsonc → not_found_handling: 404-page),
 * и переход на несуществующий адрес не доходит до Worker заявок.
 * Устроена как «Дякуємо»: шапка, первый экран (hero без заголовка) с сообщением
 * siteSettings.notFoundPage и одной кнопкой «На головну», футер.
 */
import Base from '../../layouts/Base.astro';
import Header from '../../components/blocks/Header.astro';
import Hero from '../../components/blocks/Hero.astro';
import Footer from '../../components/blocks/Footer.astro';
import { defaultLanguage } from '../../lib/languages';
import { getSiteSettings, getLanding, type HeroBlock } from '../../lib/content';
import { homePath, langOf, langPaths } from '../../lib/routes';

// Пока тексты страницы не заполнены в Sanity, страница не собирается (сборка не падает;
// integrations/not-found.ts пишет предупреждение) — несуществующий адрес получает пустой ответ 404.
export async function getStaticPaths() {
  const settings = await getSiteSettings(defaultLanguage);
  if (!settings.notFoundPage?.message) return [];
  return langPaths();
}

const lang = langOf(Astro.params.lang);
const settings = await getSiteSettings(lang);
const landing = await getLanding(lang);
const hero = landing.blocks.find((b): b is HeroBlock => b._type === 'hero');
const page = settings.notFoundPage;
const home = homePath(lang);
---
<Base lang={lang} title={page.seoTitle} description={page.message.replace(/\n/g, " ")} skipLink={settings.ui.skipLink} noindex>
  <Header lang={lang} settings={settings} base={home} />
  <main id="main" tabindex="-1">
    {hero ? <Hero block={hero} message={page.message} base={home} home={{ label: page.homeButton, href: home }} /> : <h1 class="visually-hidden">{page.message}</h1>}
  </main>
  <Footer settings={settings} base={home} />
</Base>
