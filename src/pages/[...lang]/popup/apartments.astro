---
/** Фрагмент попапа апартамента (4.17): см. layouts/PopupPage.astro. */
import PopupPage from '../../../layouts/PopupPage.astro';
import ApartmentPopup from '../../../components/popups/ApartmentPopup.astro';
import '../../../styles/popups/popup.css';
import '../../../styles/popups/apartment.css';
import { getSiteSettings, getLanding, type ApartmentsBlock, type NumbersBlock } from '../../../lib/content';
import { langOf, langPaths } from '../../../lib/routes';

export function getStaticPaths() {
  return langPaths();
}

const lang = langOf(Astro.params.lang);
const settings = await getSiteSettings(lang);
const landing = await getLanding(lang);
const apartments = landing.blocks.find((b): b is ApartmentsBlock => b._type === 'apartments');
const numbers = landing.blocks.find((b): b is NumbersBlock => b._type === 'numbers');
---
<PopupPage lang={lang} title={settings.seo.title}>
  {apartments && numbers && (
    <ApartmentPopup lang={lang} block={apartments} calc={numbers.calc} texts={settings.popups.apartment} errors={settings.form.errors} closeLabel={settings.ui.closeLabel} />
  )}
</PopupPage>
