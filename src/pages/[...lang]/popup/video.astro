---
/** Фрагмент видео-попапа (4.17): см. layouts/PopupPage.astro. */
import PopupPage from '../../../layouts/PopupPage.astro';
import VideoPopup from '../../../components/popups/VideoPopup.astro';
import '../../../styles/popups/popup.css';
import '../../../styles/popups/video.css';
import { getSiteSettings } from '../../../lib/content';
import { langOf, langPaths } from '../../../lib/routes';

export function getStaticPaths() {
  return langPaths();
}

const lang = langOf(Astro.params.lang);
const settings = await getSiteSettings(lang);
---
<PopupPage lang={lang} title={settings.seo.title}>
  <VideoPopup texts={settings.popups.video} />
</PopupPage>
