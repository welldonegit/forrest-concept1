---
/**
 * Архив хода строительства (4.18) — по archive.html выгрузки: «На головну», заголовок в две строки,
 * все отчёты от новых к старым. Шапка и футер — общие с главной (якоря ведут на блоки главной).
 * Отчёты — те же, что в блоке construction документа landing (на главной — последние; здесь — все).
 * Анимаций появления в выгрузке нет.
 */
import Base from '../../layouts/Base.astro';
import Header from '../../components/blocks/Header.astro';
import Footer from '../../components/blocks/Footer.astro';
import ConstructionUpdate from '../../components/ui/ConstructionUpdate.astro';
import '../../styles/pages/archive.css';
import { languages } from '../../lib/languages';
import { getSiteSettings, getLanding, type ConstructionBlock } from '../../lib/content';
import { homePath } from '../../lib/routes';

export function getStaticPaths() {
  return languages.map((l) => ({ params: { lang: l.id } }));
}

const { lang } = Astro.params as { lang: string };
const settings = await getSiteSettings(lang);
const landing = await getLanding(lang);
const block = landing.blocks.find((b): b is ConstructionBlock => b._type === 'construction');
const page = settings.archivePage;
const home = homePath(lang);
const updates = (block?.updates ?? []).slice().sort((a, b) => Date.parse(b.date) - Date.parse(a.date));
---
<Base lang={lang} title={page.seoTitle} description={page.seoDescription} skipLink={settings.ui.skipLink}>
  <Header lang={lang} settings={settings} base={home} path="archive/" />
  <main id="main" tabindex="-1" class="arch">
    <div class="arch__in">
      <div class="arch__head">
        <a class="arch__back text-arch-back" href={block ? `${home}#${block.anchor}` : home}>
          <span class="arch__back-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
          </span>
          {page.backLabel}
        </a>
        <h1 class="arch__title text-arch-title"><span>{page.title}</span> <span class="arch__title-sub">{page.subtitle}</span></h1>
      </div>
      {block && (
        <div class="arch__list" data-ct-archive>
          {updates.map((u) => <ConstructionUpdate update={u} block={block} lang={lang} idPrefix="arch" heading="h2" />)}
        </div>
      )}
    </div>
  </main>
  <Footer settings={settings} base={home} />
</Base>
