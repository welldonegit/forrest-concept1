---
/**
 * Hero (4.1): первый экран в скруглённой рамке. Заголовок поднимается из-за зданий
 * (передний план — то же фото, обрезанное по контуру зданий), сезонный iris-переключатель
 * лето/зима. Все тексты, фото и контур — из Sanity (блок hero документа landing).
 * Стартовое состояние — зима (как в выгрузке: state.winter = true), кнопка предлагает «вид влітку».
 * На < 768 — мобильные фото, передний план по контуру не показывается (решение 2026-11-17).
 * Поведение: src/scripts/ui/hero.js (контур, сезон, позиция кнопки на мобильном),
 * появление и параллакс заголовка — src/scripts/anim/blocks/hero.js и hero.css.
 * Страница «Дякуємо» (message): заголовка нет, вместо лида — сообщение (h1); передний план
 * по контуру не нужен (за зданиями нечего прятать). Ссылки «#…» ведут на главную (base).
 * Кнопки там — одна «На головну» (home) вместо CTA; кнопки презентации нет (решение 2026-11-19).
 */
import { getImage } from 'astro:assets';
import { resolveImage, type HeroBlock } from '../../lib/content';
import { onPage } from '../../lib/routes';

interface Props {
  block: HeroBlock;
  /** Сообщение вместо заголовка и лида (страница «Дякуємо»). */
  message?: string;
  /** Адрес главной на внутренней странице: «#forma» → «/#forma» («/en/#forma»). */
  base?: string;
  /** Страница «Дякуємо»: подпись и адрес кнопки вместо CTA блока; кнопки презентации нет. */
  home?: { label: string; href: string };
}

const { block, message, base, home } = Astro.props;
const cta = home ?? { label: block.cta.label, href: onPage(block.cta.href, base) };
const summer = await resolveImage(block.imageSummer);
const winter = await resolveImage(block.imageWinter);

// Одно и то же фото лежит в двух слоях (фон и передний план) — одинаковые адреса, один запрос.
const widths = [640, 960, 1280, 1672];
// Фото заполняет кадр по высоте, когда окно уже 16:9: ширина картинки = 178vh.
const sizes = '(max-aspect-ratio: 16/9) 178vh, 100vw';
const summerImg = await getImage({ src: summer.src, widths, format: 'avif' });
const winterImg = await getImage({ src: winter.src, widths, format: 'avif' });
// Стартовый кадр — зима: зимнее фото грузится сразу (главное фото первого экрана).
const winterAttrs = {
  src: winterImg.src,
  srcset: winterImg.srcSet.attribute,
  sizes,
  width: winter.src.width,
  height: winter.src.height,
};
// Летнее фото полностью закрыто зимним до первого переключения: адреса лежат в data-*,
// hero.js подставляет их при наведении, фокусе или касании кнопки сезона. До этого у img нет src —
// сознательное исключение из валидации HTML (этап 6): заглушка в src (data:-точка) замедляла LCP
// в Lighthouse на ≈0,7 s, а <template> скрывал бы описание фото (alt) от экранного диктора.
const summerAttrs = {
  'data-src': summerImg.src,
  'data-srcset': summerImg.srcSet.attribute,
  sizes,
  width: summer.src.width,
  height: summer.src.height,
};

// Мобильные фото (< 768, выгрузка 2026-11-17): отдельный кадр 9:16 вместо десктопного.
// Фото заполняет кадр по высоте (окно телефона уже 9:16): ширина картинки ≈ 57vh, не уже окна.
const mobileQuery = '(max-width: 767px)';
// Набор до полной ширины исходника (941): телефоны с плотностью 3 получают его, а не растянутые 720.
// 768 и 828 — промежуточные: профиль Lighthouse (412×823, DPR 1.75) просит ≈821 px и без них брал 941.
// Выше исходника не увеличиваем. Качество и ширины фото первого экрана ради скорости не снижаем (LAYOUT_RULES.md).
const mobileWidths = [480, 720, 768, 828];
const mobileSizes = 'max(100vw, 57vh)';
async function mobileSource(image: HeroBlock['imageWinterMobile']) {
  const photo = await resolveImage(image);
  const widths = [...mobileWidths.filter((w) => w < photo.src.width), photo.src.width];
  const img = await getImage({ src: photo.src, widths, format: 'avif' });
  return { srcset: img.srcSet.attribute, sizes: mobileSizes };
}
const winterM = await mobileSource(block.imageWinterMobile);
const summerM = await mobileSource(block.imageSummerMobile);
const skyline = JSON.stringify(block.skyline);
const [line1, line2] = block.title;
const leadLines = (message ?? block.lead).split('\n');
const Lead = message ? 'h1' : 'p';
---
<div class="hero" id="top">
  <section
    class="hero__frame"
    aria-labelledby={message ? 'hero-message' : 'hero-title'}
    data-hero
    data-season="winter"
    data-skyline={skyline}
    data-anim-block="hero"
    data-anim-eager
  >
    <div class="hero__media">
      <picture><source media={mobileQuery} data-srcset={summerM.srcset} sizes={summerM.sizes} /><img class="hero__img" {...summerAttrs} alt={summer.alt} decoding="async" data-hero-deferred style={`--focus:${summer.position}`} /></picture>
      <div class="hero__iris" data-hero-iris>
        <picture><source media={mobileQuery} srcset={winterM.srcset} sizes={winterM.sizes} /><img class="hero__img" {...winterAttrs} alt={winter.alt} loading="eager" fetchpriority="high" decoding="async" style={`--focus:${winter.position}`} /></picture>
      </div>

      {!message && (<>
      <h1 class="hero__title text-hero-h1" id="hero-title" data-hero-title>
        <span class="hero__line hero__line--dark">{line1}</span>
        <span class="hero__line hero__line--light">{line2}</span>
      </h1>

      <div class="hero__fg" data-hero-fg>
        <picture><source media={mobileQuery} data-srcset={summerM.srcset} sizes={summerM.sizes} /><img class="hero__img" {...summerAttrs} alt="" decoding="async" data-hero-deferred style={`--focus:${summer.position}`} /></picture>
      </div>
      <div class="hero__iris" data-hero-iris>
        <div class="hero__fg" data-hero-fg>
          <picture><source media={mobileQuery} srcset={winterM.srcset} sizes={winterM.sizes} /><img class="hero__img" {...winterAttrs} alt="" decoding="async" style={`--focus:${winter.position}`} /></picture>
        </div>
      </div>

      <!-- Копия заголовка над передним планом: проявляется, когда подъём закончен. -->
      <div class="hero__title hero__title--front text-hero-h1" aria-hidden="true" data-hero-title>
        <span class="hero__line hero__line--dark">{line1}</span>
        <span class="hero__line hero__line--light">{line2}</span>
      </div>
      </>)}
    </div>

    <!-- Заслонка цвета рамки: проявление кадра (opacity 1 → 0). Фото под ней непрозрачно с первого кадра —
         иначе Chrome не считает его кандидатом LCP (PageSpeed: NO_LCP). -->
    <div class="hero__curtain" aria-hidden="true"></div>

    <div class="hero__shade" aria-hidden="true"></div>

    <div class="hero__content" data-hero-content>
      <Lead class="hero__lead text-hero-lead" id={message ? 'hero-message' : undefined}>
        {leadLines.map((line, i) => (
          <>{i > 0 && <>{" "}<br class="hero__br" /></>}{line}</>
        ))}
      </Lead>
      <div class="hero__buttons">
        <a class="hero__cta text-hero-button-lg" href={cta.href}>
          {cta.label}
          <span class="hero__cta-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </span>
        </a>
        {!home && (<>
        <!-- Видео презентации — тот же видео-попап, что у Season (components/popups/VideoPopup.astro), решение 2026-11-25.
             Поле «Відео презентації» пустое — кнопка без действия, как в выгрузке. -->
        <button class="hero__play text-hero-button-lg" type="button" aria-haspopup={block.presentationVideoUrl ? 'dialog' : undefined} data-popup={block.presentationVideoUrl ? 'video' : undefined} data-video-src={block.presentationVideoUrl || undefined}>
          <span class="hero__play-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M7 4.5v15l13-7.5z" /></svg>
          </span>
          <span class="hero__play-label">{block.presentationLabel}</span>
        </button>
        </>)}
      </div>
    </div>

    <button
      class="hero__season text-hero-caption"
      type="button"
      data-hero-season
      data-to-winter={block.season.toWinter}
      data-to-summer={block.season.toSummer}
    >
      <!-- Стекло (backdrop-filter) неподвижно; масштабируются только обводка и содержимое. -->
      <span class="hero__season-glass" aria-hidden="true"></span>
      <span class="hero__season-face">
      <span class="hero__ring" aria-hidden="true"></span>
      <span class="hero__ring hero__ring--late" aria-hidden="true"></span>
      <svg class="hero__star" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6 5.6 18.4" /></svg>
      <span>{block.season.prefix}<br /><span data-hero-season-label>{block.season.toSummer}</span></span>
      </span>
    </button>
  </section>
</div>
