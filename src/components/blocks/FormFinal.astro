---
/**
 * Final Form (4.15): «Оберіть свій актив у FORREST». Та же секция с формой, что у Form
 * (src/components/ui/LeadSection.astro): те же поля, проверка, тексты ошибок, успех и эксперт.
 * Отличаются раскладка (модификатор form--final: компактные поля, подпись рядом с кнопкой)
 * и контент — из Sanity (блок formFinal документа landing): заголовок, текст, карточки,
 * поле «Категорія інвестиції», способы связи, кнопка и подпись.
 */
import LeadSection from '../ui/LeadSection.astro';
import { getBlockUk, ukIfDiffers, type ApartmentFormat, type FormFinalBlock, type SiteSettings } from '../../lib/content';
import { fill, formatNumber } from '../../lib/calc';

interface Props {
  block: FormFinalBlock;
  settings: SiteSettings;
  /** Форматы в порядке блока Apartments. */
  formats: ApartmentFormat[];
  lang: string;
}

const { block, settings, formats, lang } = Astro.props;
// Поле «Категорія інвестиції» (решение заказчика 2026-11-26, вместо вопроса о цели): вариант —
// «Superior — 29,5–34,5 м² — від 132 750 $», без цены — без последней части. В заявку — название
// формата (category; в CRM — «Тип планування», в Telegram — «Категорія»). Ничего не выбрано по умолчанию.
const uk = await getBlockUk(block);
const withUk = <T extends { _key: string; label: string }>(items: T[], ukItems: T[]) =>
  items.map((o) => ({ ...o, uk: ukIfDiffers(o.label, ukItems.find((u) => u._key === o._key)?.label) }));
const categories = [
  { value: '', label: block.categoryPlaceholder, placeholder: true },
  ...formats.map((f) => ({
    value: f.name,
    label: [f.name, f.area, f.priceFrom ? fill(block.categoryPrice, formatNumber(f.priceFrom, lang)) : ''].filter(Boolean).join(' — '),
  })),
];
const contactOptions = withUk(block.contactOptions, uk.contactOptions);
---
<LeadSection
  id={block.anchor}
  variant="final"
  title={block.title}
  text={block.text}
  bullets={block.bullets}
  select={{ label: block.categoryLabel, name: 'category', options: categories }}
  contactLegend={block.contactLegend}
  contactOptions={contactOptions}
  submitLabel={block.submitLabel}
  note={block.note}
  settings={settings}
/>
