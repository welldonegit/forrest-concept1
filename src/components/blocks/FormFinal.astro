---
/**
 * Final Form (4.15): «Оберіть свій актив у FORREST». Та же секция с формой, что у Form
 * (src/components/ui/LeadSection.astro): те же поля, проверка, тексты ошибок, успех и эксперт.
 * Отличаются раскладка (модификатор form--final: компактные поля, подпись рядом с кнопкой)
 * и контент — из Sanity (блок formFinal документа landing): заголовок, текст, карточки,
 * вопрос о цели инвестиции с вариантами, способы связи, кнопка и подпись.
 */
import LeadSection from '../ui/LeadSection.astro';
import { getBlockUk, ukIfDiffers, type FormFinalBlock, type SiteSettings } from '../../lib/content';

interface Props {
  block: FormFinalBlock;
  settings: SiteSettings;
}

const { block, settings } = Astro.props;
// Вопрос «Який формат інвестиції…» — цель покупки (в заявке purpose, в CRM note_purpose).
const uk = await getBlockUk(block);
const withUk = <T extends { _key: string; label: string }>(items: T[], ukItems: T[]) =>
  items.map((o) => ({ ...o, uk: ukIfDiffers(o.label, ukItems.find((u) => u._key === o._key)?.label) }));
const goals = withUk(block.goals, uk.goals);
const contactOptions = withUk(block.contactOptions, uk.contactOptions);
---
<LeadSection
  id={block.anchor}
  variant="final"
  title={block.title}
  text={block.text}
  bullets={block.bullets}
  select={{ label: block.goalLabel, name: 'goal', options: goals }}
  contactLegend={block.contactLegend}
  contactOptions={contactOptions}
  submitLabel={block.submitLabel}
  note={block.note}
  settings={settings}
/>
