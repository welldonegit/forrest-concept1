---
/**
 * Form (4.7): «Отримайте фінмодель». Разметка, проверка полей и появление — общие
 * с Final Form: src/components/ui/LeadSection.astro.
 * Тексты блока — из Sanity (блок form документа landing); подписи полей, варианты списка
 * (форматы апартаментов), способы связи и кнопка — из siteSettings.form.
 */
import LeadSection from '../ui/LeadSection.astro';
import { areaRange, getSiteSettingsUk, ukIfDiffers, type FormBlock, type SiteSettings } from '../../lib/content';

interface Props {
  block: FormBlock;
  settings: SiteSettings;
}

const { block, settings } = Astro.props;
const f = settings.form;
const fUk = (await getSiteSettingsUk()).form;
// Поле «Площа апартаментів»: формат и его площадь. В заявку — название формата (не переводится)
// и площадь числами; «Ще не визначився» — украинской подписью.
const options = [
  { label: f.formatUndecidedLabel, uk: ukIfDiffers(f.formatUndecidedLabel, fUk.formatUndecidedLabel) },
  ...f.formats.map((o) => {
    const { from, to } = areaRange(o.area);
    return { label: `${o.name}, ${o.area}`, format: o.name, areaFrom: from, areaTo: to };
  }),
];
const contactOptions = f.contactOptions.map((o) => ({
  ...o,
  uk: ukIfDiffers(o.label, fUk.contactOptions.find((u) => u._key === o._key)?.label),
}));
---
<LeadSection
  id={block.anchor}
  variant="form"
  title={block.title}
  text={block.text}
  bullets={block.bullets}
  select={{ label: f.formatLabel, name: 'format', options }}
  contactLegend={f.contactLegend}
  contactOptions={contactOptions}
  submitLabel={f.submitLabel}
  settings={settings}
/>
