---
/**
 * Construction B (4.12): «Хід будівництва» — большие карточки помесячных отчётов в горизонтальной
 * ленте (кнопки «назад/вперёд» листают по карточке), в карточке — фото (своя лента с кнопками),
 * кнопка дрон-видео, заголовок, текст, список работ; в конце ленты — карточка «Всі» (архив).
 * Выгрузка 2026-11-17, секция «Construction B» (data-ct2). id секции без «-2»: на него ведут меню и футер.
 * Тексты, фото, даты — из Sanity (блок construction документа landing).
 *
 * Как в выгрузке: показываются отчёты не старше maxAgeDays от даты сборки, последние maxItems.
 * Карточка месяца — ui/ConstructionUpdate.astro (та же на странице архива). Подпись месяца — lib/dates.ts.
 * Листание — src/scripts/ui/construction.js. Анимации появления в выгрузке нет.
 * «Всі» ведёт на страницу архива (4.18, lib/routes.ts), там — все отчёты.
 */
import ConstructionUpdate from '../ui/ConstructionUpdate.astro';
import type { ConstructionBlock } from '../../lib/content';
import { archivePath } from '../../lib/routes';

interface Props {
  block: ConstructionBlock;
  lang: string;
}

const { block, lang } = Astro.props;
const id = block.anchor;
const now = Date.now();
const updates = block.updates
  .filter((u) => Date.parse(u.date) >= now - block.maxAgeDays * 864e5)
  .sort((a, b) => Date.parse(b.date) - Date.parse(a.date))
  .slice(0, block.maxItems);

const arrow = (dir: 'prev' | 'next') => (dir === 'prev' ? 'M19 12H5M11 6l-6 6 6 6' : 'M5 12h14M13 6l6 6-6 6');
---
<section class="ct" id={id} aria-labelledby={`${id}-title`} data-ct>
  <div class="ct__head">
    <h2 class="ct__title text-display-sm" id={`${id}-title`}>{block.title}</h2>
    <div class="ct__nav">
      <button class="ct__btn" type="button" aria-label={block.rowPrevLabel} aria-controls={`${id}-row`} data-ct-row-prev>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={arrow('prev')} /></svg>
      </button>
      <button class="ct__btn" type="button" aria-label={block.rowNextLabel} aria-controls={`${id}-row`} data-ct-row-next>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={arrow('next')} /></svg>
      </button>
    </div>
  </div>

  <div class="ct__row" id={`${id}-row`} data-ct-row>
    {updates.map((u) => (
      <ConstructionUpdate update={u} block={block} lang={lang} idPrefix={id} />
    ))}
    <a class="ct__arch" href={archivePath(lang)} aria-label={block.archive.ariaLabel}>
      <span class="ct__arch-text">
        <span class="ct__arch-title text-ct-arch-title">{block.archive.title}</span>
        <span class="ct__arch-p text-ct-arch-text">{block.archive.text}</span>
      </span>
      <span class="ct__arch-arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d={arrow('next')} /></svg>
      </span>
    </a>
  </div>
</section>
