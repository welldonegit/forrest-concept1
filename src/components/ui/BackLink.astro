---
/**
 * Ссылка «На головну» внутренних страниц (архив, документы) — по archive.html выгрузки:
 * плашка со стрелкой, при наведении стрелка сдвигается. Подпись — из Sanity.
 */
import '../../styles/components/back-link.css';

interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---
<a class="back-link text-arch-back" href={href}>
  <span class="back-link__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
  </span>
  {label}
</a>
