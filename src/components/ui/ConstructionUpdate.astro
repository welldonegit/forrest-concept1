---
/**
 * Карточка месячного отчёта о строительстве: месяц и черга, фото (своя лента с кнопками),
 * кнопка дрон-видео, заголовок, текст, список работ. Черги и абзаца может не быть — тогда их нет в разметке. Одна разметка для Construction (лента на главной)
 * и страницы архива (4.18); стили — styles/blocks/construction.css, листание фото — scripts/ui/construction.js.
 * TODO: дрон-видео — файлов нет, кнопка без действия (попап видео 4.17 подключится, когда появится файл).
 */
import { Image } from 'astro:assets';
import { resolveImage, type ConstructionBlock, type ConstructionUpdate } from '../../lib/content';
import { monthOf } from '../../lib/dates';

interface Props {
  update: ConstructionUpdate;
  block: ConstructionBlock;
  lang: string;
  /** Префикс id заголовка. */
  idPrefix: string;
  /** Уровень заголовка карточки: на главной h3 (под h2 блока), на архиве h2 (под h1 страницы). */
  heading?: 'h2' | 'h3';
}

const { update: u, block, lang, idPrefix, heading = 'h3' } = Astro.props;
const photos = await Promise.all(u.slides.map(resolveImage));
const Heading = heading;
const titleId = `${idPrefix}-${u._key}`;
const arrow = (dir: 'prev' | 'next') => (dir === 'prev' ? 'M19 12H5M11 6l-6 6 6 6' : 'M5 12h14M13 6l6 6-6 6');
---
<article class="ct__item" data-ct-item aria-labelledby={titleId}>
  <div class="ct__item-head">
    <time class="ct__month text-ct-month" datetime={u.date}>{monthOf(u.date, lang)}</time>
    {u.queue && <span class="ct__queue text-ct-queue">{u.queue}</span>}
  </div>
  <div class="ct__card">
    <div class="ct__media">
      <div class="ct__slides" data-ct-slides>
        {photos.map((ph) => (
          <div class="ct__slide">
            <Image class="ct__img" src={ph.src} alt={ph.alt} widths={[360, 560, 720, 880, 1160]} sizes="(max-width: 767px) calc(100vw - 52px), (max-width: 1279px) calc(100vw - 76px), 580px" format="avif" loading="lazy" decoding="async" style={`--focus:${ph.position}`} />
          </div>
        ))}
      </div>
      <div class="ct__photo-nav">
        <button class="ct__btn ct__btn--glass" type="button" aria-label={block.photoPrevLabel} data-ct-photo-prev>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={arrow('prev')} /></svg>
        </button>
        <button class="ct__btn ct__btn--glass" type="button" aria-label={block.photoNextLabel} data-ct-photo-next>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={arrow('next')} /></svg>
        </button>
      </div>
      {u.video && (
        <button class="ct__video text-ct-video" type="button" aria-label={block.videoAriaLabel} data-ct-video>
          <span class="ct__play" aria-hidden="true"><svg viewBox="0 0 12 12" focusable="false"><path d="M3 1.5v9l7.5-4.5z" /></svg></span><span>{block.videoLabel}</span><span>{u.video.duration}</span>
        </button>
      )}
    </div>
    <div class="ct__body">
      <Heading class="ct__item-title text-ct-title" id={titleId}>{u.title}</Heading>
      {u.text && <p class="ct__text text-ct-text">{u.text}</p>}
      <ul class="ct__works" role="list">
        {u.works.map((w) => (
          <li class="ct__work text-ct-work">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
            <span>{w.text}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</article>
