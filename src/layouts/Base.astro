---
/**
 * Базовый шаблон страницы: язык и направление письма, мета-теги, предзагрузка
 * шрифтов первого экрана, отложенный GTM, пропуск к содержимому.
 * SEO (этап 6): canonical, hreflang (все языки + x-default), Open Graph, Twitter, иконки, JSON-LD (слот head).
 * noindex — «Дякуємо» и 404: всегда закрыты от индекса, без canonical и hreflang.
 */
import '../styles/main.css';
import { getLanguage, languages } from '../lib/languages';
import { getSiteSettings } from '../lib/content';
import { homePath, thanksPath } from '../lib/routes';
import { alternates, ogImage, pageUrl } from '../lib/seo';
import { LEAD_FORM_NAMES } from '../lib/lead-forms';

/** Через сколько мс после загрузки страницы подключить GTM, если посетитель ничего не сделал. */
const GTM_DELAY = 5000;

interface Props {
  lang: string;
  title: string;
  description: string;
  skipLink: string;
  /** Путь страницы после адреса главной: «» — главная, «archive/», «dokumenty/<slug>/». У 404 нет (адрес любой). */
  path?: string;
  /** Не индексировать («Дякуємо», 404) — независимо от SITE_INDEXING. */
  noindex?: boolean;
  /** «Дякуємо»: прочитать lead_event из sessionStorage и отправить generate_lead (docs/LEADS.md, «Аналитика»). */
  leadEvent?: boolean;
}

const { lang, title, description, skipLink, path, noindex = false, leadEvent = false } = Astro.props;
const language = getLanguage(lang);
const settings = await getSiteSettings(lang);
const gtmId = settings.analytics?.gtmId?.trim();
const site = Astro.site!;
const url = path === undefined ? undefined : pageUrl(site, lang, path);
const canonical = noindex ? undefined : url;
const links = canonical ? alternates(site, path) : [];
const og = await ogImage(site, lang);
const siteName = settings.seo.siteName?.trim();
const fonts = [`/fonts/unbounded-${language.subset}.woff2`, `/fonts/mulish-${language.subset}.woff2`];
---
<!doctype html>
{/*
  data-base — адрес главной этого языка («/», «/en/»): от него скрипты строят адреса (попапы).
  data-thanks — «Дякуємо» этого языка: туда ведут формы после заявки (lead-api.js, goThanks).
*/}
<html lang={language.id} dir={language.dir} data-base={homePath(language.id)} data-thanks={thanksPath(language.id)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/*
      Google Tag Manager — отложенно (CLAUDE.md, «Скорость»): очередь dataLayer создаётся сразу,
      а gtm.js грузится при первом действии посетителя (прокрутка, касание, клавиша)
      или через GTM_DELAY мс после загрузки страницы. ID контейнера — siteSettings.analytics.gtmId
      (Sanity, вкладка «Технічне»); пусто — GTM не подключается.
      «Дякуємо» (leadEvent): lead_event из sessionStorage читается и сразу удаляется (обновление и прямой
      заход события не дают); есть — generate_lead в очередь после gtm.start и gtm.js сразу, без ожидания
      действия посетителя: иначе событие теряется, если вкладку закрыли. Без lead_event — как обычно.
      Запасной путь (sessionStorage на странице формы недоступен): ?lead_id=FR-…&form_id=…&form_location=…
      без личных данных → событие без user_data. Параметры сразу убираются из адреса (history.replaceState):
      обновление события не даёт. Неизвестный form_id или номер не FR-… — события нет.
    */}
    {(gtmId || leadEvent) && <script is:inline define:vars={{ gtmId: gtmId ?? '', delay: GTM_DELAY, leadEvent, formNames: leadEvent ? LEAD_FORM_NAMES : {} }}>
window.dataLayer=window.dataLayer||[];
if(gtmId){window.gtag=function(){dataLayer.push(arguments)};gtag('js',new Date());dataLayer.push({'gtm.start':Date.now(),event:'gtm.js'})}
let lead=null;
if(leadEvent){try{const s=sessionStorage.getItem('lead_event');sessionStorage.removeItem('lead_event');const e=s&&JSON.parse(s);if(e&&e.event==='generate_lead'&&e.lead_id)lead=e}catch(_){}
const q=new URLSearchParams(location.search);
if(q.has('lead_id')){const id=q.get('lead_id'),f=q.get('form_id'),at=q.get('form_location')||'';
if(!lead&&/^FR-\d{6,}$/.test(id)&&Object.hasOwn(formNames,f)&&/^\/[\w\-\/]*$/.test(at))lead={event:'generate_lead',lead_id:id,form_id:f,form_name:formNames[f],form_location:at};
for(const k of['lead_id','form_id','form_location'])q.delete(k);
try{history.replaceState(history.state,'',location.pathname+(q.size?'?'+q:'')+location.hash)}catch(_){}}}
if(lead)dataLayer.push(lead);
if(gtmId)(()=>{const ev=['scroll','pointerdown','keydown','touchstart'];let done=0;
const load=()=>{if(done)return;done=1;for(const t of ev)removeEventListener(t,load,true);
const s=document.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtm.js?id='+encodeURIComponent(gtmId);document.head.appendChild(s)};
if(lead){load();return}
for(const t of ev)addEventListener(t,load,{capture:true,passive:true});
addEventListener('load',()=>setTimeout(load,delay))})();
    </script>}
    <title>{title}</title>
    <meta name="description" content={description} />
    {fonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <script is:inline>document.documentElement.classList.add('js');</script>
    <!--
      Картинки ниже первого экрана (loading="lazy") не делят канал с главным фото первого экрана:
      по мере разбора страницы их адреса придерживаются и возвращаются, когда главное фото
      (img[fetchpriority=high]) загрузилось, страница загрузилась или посетитель начал прокрутку страницы/ввод
      (прокрутка элементов — например, автопрокрутка ленты Infrastructure — не считается).
      Дальше — обычная ленивая загрузка браузера. Без JS картинки грузятся как обычно. LAYOUT_RULES.md, «Скорость».
    -->
    <script is:inline>(()=>{const d=document,H='data-hold-',held=[];let done=0;
const hold=(e)=>{for(const a of['srcset','src'])if(e.hasAttribute(a)){e.setAttribute(H+a,e.getAttribute(a));e.removeAttribute(a)}held.push(e)};
const mo=new MutationObserver((ms)=>{try{for(const m of ms)for(const n of m.addedNodes){if(n.nodeType!==1)continue;
for(const i of n.matches('img[loading=lazy]')?[n]:n.querySelectorAll('img[loading=lazy]')){const p=i.parentElement;if(p&&p.tagName==='PICTURE')p.querySelectorAll('source[srcset]').forEach(hold);hold(i)}}}catch(_){}});
mo.observe(d.documentElement,{childList:true,subtree:true});
const go=()=>{if(done)return;done=1;mo.disconnect();for(const e of held)try{for(const a of['srcset','src']){const v=e.getAttribute(H+a);if(v!==null){e.setAttribute(a,v);e.removeAttribute(H+a)}}}catch(_){}
for(const t of['scroll','keydown','pointerdown','touchstart'])removeEventListener(t,user,true)};
const user=(e)=>{if(e.type!=='scroll'||e.target===d)go()};
for(const t of['scroll','keydown','pointerdown','touchstart'])addEventListener(t,user,{capture:true,passive:true});
addEventListener('load',go);
d.addEventListener('DOMContentLoaded',()=>{const m=d.querySelector('img[fetchpriority=high]');if(!m||m.complete)return go();m.addEventListener('load',go);m.addEventListener('error',go)})})();</script>
    {/* SEO, соцсети, иконки — в конце head: после шрифтов и скриптов первого экрана, чтобы не отнимать у них сеть. */}
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {links.map((l) => <link rel="alternate" hreflang={l.hreflang} href={l.href} />)}
    <meta property="og:type" content="website" />
    {siteName && <meta property="og:site_name" content={siteName} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {url && <meta property="og:url" content={url} />}
    <meta property="og:locale" content={language.locale} />
    {languages.filter((l) => l.id !== language.id).map((l) => <meta property="og:locale:alternate" content={l.locale} />)}
    {og && <>
      <meta property="og:image" content={og.url} />
      <meta property="og:image:type" content={og.type} />
      <meta property="og:image:width" content={String(og.width)} />
      <meta property="og:image:height" content={String(og.height)} />
      {og.alt && <meta property="og:image:alt" content={og.alt} />}
    </>}
    <meta name="twitter:card" content={og ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {og && <meta name="twitter:image" content={og.url} />}
    {og?.alt && <meta name="twitter:image:alt" content={og.alt} />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href={`${homePath(language.id)}site.webmanifest`} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{skipLink}</a>
    <slot />
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
