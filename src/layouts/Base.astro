---
/**
 * Базовый шаблон страницы: язык и направление письма, мета-теги, предзагрузка
 * шрифтов первого экрана, место под GTM, пропуск к содержимому.
 */
import '../styles/main.css';
import { getLanguage } from '../lib/languages';

interface Props {
  lang: string;
  title: string;
  description: string;
  skipLink: string;
}

const { lang, title, description, skipLink } = Astro.props;
const language = getLanguage(lang);
const fonts = [`/fonts/unbounded-${language.subset}.woff2`, `/fonts/mulish-${language.subset}.woff2`];
---
<!doctype html>
<html lang={language.id} dir={language.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {fonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <script is:inline>document.documentElement.classList.add('js');</script>
    <!--
      Картинки ниже первого экрана (loading="lazy") не делят канал с главным фото первого экрана:
      по мере разбора страницы их адреса придерживаются и возвращаются, когда главное фото
      (img[fetchpriority=high]) загрузилось, страница загрузилась или посетитель начал прокрутку/ввод.
      Дальше — обычная ленивая загрузка браузера. Без JS картинки грузятся как обычно. LAYOUT_RULES.md, «Скорость».
    -->
    <script is:inline>(()=>{const d=document,H='data-hold-',held=[];let done=0;
const hold=(e)=>{for(const a of['srcset','src'])if(e.hasAttribute(a)){e.setAttribute(H+a,e.getAttribute(a));e.removeAttribute(a)}held.push(e)};
const mo=new MutationObserver((ms)=>{for(const m of ms)for(const n of m.addedNodes){if(n.nodeType!==1)continue;
for(const i of n.matches('img[loading=lazy]')?[n]:n.querySelectorAll('img[loading=lazy]')){const p=i.parentElement;if(p&&p.tagName==='PICTURE')p.querySelectorAll('source[srcset]').forEach(hold);hold(i)}}});
mo.observe(d.documentElement,{childList:true,subtree:true});
const go=()=>{if(done)return;done=1;mo.disconnect();for(const e of held)for(const a of['srcset','src']){const v=e.getAttribute(H+a);if(v!==null){e.setAttribute(a,v);e.removeAttribute(H+a)}}
for(const t of['scroll','keydown','pointerdown','touchstart'])removeEventListener(t,go,true)};
for(const t of['scroll','keydown','pointerdown','touchstart'])addEventListener(t,go,{capture:true,passive:true});
addEventListener('load',go);
d.addEventListener('DOMContentLoaded',()=>{const m=d.querySelector('img[fetchpriority=high]');if(!m||m.complete)return go();m.addEventListener('load',go);m.addEventListener('error',go)})})();</script>
    <!-- TODO(6.x): canonical, hreflang, og — после выбора домена. TODO(7.2): GTM, отложенная загрузка. -->
  </head>
  <body>
    <a class="skip-link" href="#main">{skipLink}</a>
    <slot />
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
